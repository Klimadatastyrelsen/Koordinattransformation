# local stack from compose.yml
VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_PATH=/v1.2/trans/
VITE_AUTH_URL=http://localhost:8080/default
VITE_AUTH_CLIENT_ID=koord
VITE_AUTH_AUDIENCE=http://localhost:8000
VITE_BIFROST_URL=/bifrost

# the dev proxy uses a key from kds auth because bifrost rejects mock login tokens
BIFROST_URL=
BIFROST_KEY=

# greenland map token from https://dataforsyningen.dk/
VITE_DATAFORSYNING_TOKEN=

# denmark map api key from https://datafordeler.dk/ under autentifikationsmetoder
VITE_DATAFORDELER_TOKEN=
